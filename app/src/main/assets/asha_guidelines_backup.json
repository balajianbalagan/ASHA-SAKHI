    "nutrition": {
      "guidelines": [
        {
          "title": "Pregnancy Nutrition Guidelines",
          "description": "Evidence‑based dietary requirements for pregnant women in India.",
          "type": "pregnancy",
          "key_points": [
            "Extra +300 kcal/day second & third trimesters",
            "≥65 g protein/day (dal, eggs, milk, lean meat)",
            "Daily IFA 100 mg iron + 0.5 mg folic acid × 100 days (National Iron + Initiative)",
            "1 tablet calcium (500 mg) twice daily away from IFA",
            "Adequate fluids ≥2.5 L, emphasize safe water"
          ],
          "guidelines": [
            "3 balanced meals + 2 healthy snacks",
            "Include at least 5 servings of fruit/vegetables",
            "Weekly fish/omega‑3 rich food unless contra‑indicated",
            "Daily milk/curd for calcium & vitamin D",
            "Limit caffeine <200 mg/day; avoid alcohol & tobacco"
          ],
          "taboos_and_misconceptions": [
            {
              "myth": "Papaya or pineapple always cause miscarriage",
              "evidence": "Ripe fruit is safe; only unripe/raw papaya latex has uterotonic effect.",
              "action": "Allow ripe papaya/pineapple in moderation for vitamins A & C."
            },
            {
              "myth": "Eggs and meat make the baby 'big' and delivery difficult",
              "evidence": "High‑quality protein prevents low‑birth‑weight.",
              "action": "Encourage 1 egg/day if affordable; monitor weight gain."
            },
            {
              "myth": "Pregnant women should avoid milk when they have cough/cold",
              "evidence": "No scientific basis; calcium need rises in pregnancy.",
              "action": "Continue milk/curd unless lactose‑intolerant."
            }
          ],
          "procedures": [
            "24‑h diet recall → identify gaps",
            "Counsel with local food examples & portion sizes",
            "Monthly weight check, MUAC if under‑weight",
            "Link to take‑home rations / THR under ICDS where available"
          ],
          "warnings": [
            "Avoid raw or under‑cooked meat, fish & eggs (listeriosis risk)",
            "Restrict processed foods high in salt & trans‑fat",
            "No herbal/home remedies without medical advice"
          ],
          "references": [
            "https://nhm.gov.in/images/pdf/Nutrition/AMB-guidelines/Anemia-Mukt-Bharat-Operational-Guidelines-FINAL.pdf",
            "https://www.who.int/publications/i/item/9789240008120",
            "https://pmc.ncbi.nlm.nih.gov/articles/PMC6396620/",
            "https://pmc.ncbi.nlm.nih.gov/articles/PMC6886130/"
          ]
        }
      ]
